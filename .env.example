# Публічна адреса сайту (потрібна monobank для callback і повернення після оплати)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_GOAL_USD=8000

# Monobank еквайринг (Plata by mono): токен мерчанта з https://web.monobank.ua/
# Тестовий токен: https://api.monobank.ua/docs/acquiring.html
MONO_TOKEN=

# Firebase Admin (Firebase Console -> Project settings -> Service accounts -> Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Запасний курс UAH за 1 USD, якщо API НБУ недоступне
FALLBACK_USD_UAH=41.5
